{
  "language": "go",
  "project_shape": "backend",
  "source_extensions": [
    ".go"
  ],
  "build_command": "go build ./...",
  "testing": "deferred",
  "service": {
    "run_command": "go run ./cmd/paleo-prep-station --addr 127.0.0.1:18133",
    "health_url": "http://127.0.0.1:18133/healthz"
  },
  "workflow_checks": [
    {
      "workflow_id": "register-specimen",
      "command": "go run ./cmd/workflowcheck --workflow register-specimen"
    },
    {
      "workflow_id": "approve-prep-plan",
      "command": "go run ./cmd/workflowcheck --workflow approve-prep-plan"
    },
    {
      "workflow_id": "log-preparation",
      "command": "go run ./cmd/workflowcheck --workflow log-preparation"
    },
    {
      "workflow_id": "release-for-study",
      "command": "go run ./cmd/workflowcheck --workflow release-for-study"
    },
    {
      "workflow_id": "batch-shared-progress",
      "command": "go run ./cmd/workflowcheck --workflow batch-shared-progress"
    },
    {
      "workflow_id": "batch-atomic-failure",
      "command": "go run ./cmd/workflowcheck --workflow batch-atomic-failure"
    },
    {
      "workflow_id": "batch-split",
      "command": "go run ./cmd/workflowcheck --workflow batch-split"
    },
    {
      "workflow_id": "batch-cancel",
      "command": "go run ./cmd/workflowcheck --workflow batch-cancel"
    },
    {
      "workflow_id": "batch-member-cancel",
      "command": "go run ./cmd/workflowcheck --workflow batch-member-cancel"
    },
    {
      "workflow_id": "batch-concurrent",
      "command": "go run ./cmd/workflowcheck --workflow batch-concurrent"
    }
  ]
}
